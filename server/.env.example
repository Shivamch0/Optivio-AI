PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
MONGO_URL=mongodb://127.0.0.1:27017

ACCESS_TOKEN_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
REFRESH_TOKEN_EXPIRY=10d

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180

# SEO/AI providers
PAGESPEED_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Password reset email providers. Use either one.
EMAIL_FROM=Optivio AI <no-reply@optivio.ai>
RESEND_API_KEY=
SENDGRID_API_KEY=

# Auth providers
GOOGLE_CLIENT_ID=
SSO_LOGIN_URL=

# Billing
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
